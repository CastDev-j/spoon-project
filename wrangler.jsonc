{
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "spoon-project",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spoon_project",
      "database_id": "3711f49a-2cfb-49e1-840e-cda396c6b76e",
      "remote": true,
    },
  ],
}
