---
import { ArticlesTable } from "../article/ArticlesTable";
import { UpsertForm } from "../article/UpsertForm";
---

<div class="min-h-dvh flex items-center justify-center py-8 px-4 w-full">
  <div
    class="w-full max-w-4xl min-h-112 rounded-2xl border border-jeton-red/20 bg-canvas-white overflow-hidden flex flex-col"
  >
    <div class="flex flex-col md:flex-row flex-1">
      <div
        class="order-2 md:order-1 md:w-3/5 md:border-r border-jeton-red/10 flex flex-col flex-1 min-h-72"
      >
        <ArticlesTable client:load />
      </div>
      <div class="order-1 md:order-2 md:w-2/5 flex flex-col">
        <UpsertForm client:load />
      </div>
    </div>
  </div>
</div>
