---
import type { User } from "better-auth";

interface Props {
  user: User;
}

const { user } = Astro.props;
---

<section
  class="flex flex-col items-center w-full mx-auto border border-neutral-400 p-4 rounded-sm"
>
  <p class="self-end text-xs text-neutral-500">
    {user.createdAt.toLocaleDateString()}
  </p>

  <div class="flex items-center gap-4 self-start w-full">
    {
      user.image ? (
        <img
          src={user.image}
          alt={user.name}
          height={48}
          width={48}
          class="size-12 rounded-full self-start"
        />
      ) : (
        <span class="self-start flex justify-center items-center size-16 text-2xl bg-neutral-900  text-neutral-50 rounded-full">
          {user.name.slice(0, 2).toUpperCase()}
        </span>
      )
    }

    <div class="flex flex-col w-full min-w-0">
      <p class="font-semibold truncate">{user.name}</p>
      <p class="text-neutral-500 truncate">{user.email}</p>
    </div>
  </div>
</section>
